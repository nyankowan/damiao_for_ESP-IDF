menu "DAMIAO motor driver"

    config DM_TWAI_BITRATE
        int "TWAI (CAN) bitrate [bps]"
        default 1000000
        help
            モーター側のCANボーレート設定と一致させる．

    config DM_TWAI_TX_QUEUE_LEN
        int "TX queue length"
        range 1 64
        default 8
        help
            送信待ちにできるフレーム数．

    config DM_TWAI_RX_QUEUE_LEN
        int "RX queue length"
        range 1 256
        default 16
        help
            dm_receive() で読み出されるまで保持できる受信フレーム数．
            満杯の場合，新しく受信したフレームは破棄される．

endmenu
